<!DOCTYPE html>
<html lang="sv">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} – Morfos Edtech Akademi{% else %}Morfos Edtech Akademi – Kunskap som får form{% endif %}</title>
<meta name="description" content="{{ description or 'Morfos Edtech Akademi gör om företags egna rutiner, instruktioner och presentationer till interaktiva e-kurser – och visar vem som har gått dem.' }}">
<link rel="canonical" href="https://www.morfos.se{{ page.url }}">
<link rel="alternate" type="application/atom+xml" title="Morfos blogg" href="/blogg/feed.xml">
<link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png">
<link rel="apple-touch-icon" href="/icon-180.png">
<meta name="theme-color" content="#f8f7f2">
<meta property="og:site_name" content="Morfos Edtech Akademi">
<meta property="og:locale" content="sv_SE">
<meta property="og:title" content="{{ title or 'Morfos Edtech Akademi – Kunskap som får form' }}">
<meta property="og:description" content="{{ description or 'E-kurser byggda av era egna rutiner.' }}">
<meta property="og:url" content="https://www.morfos.se{{ page.url }}">
<meta property="og:image" content="https://www.morfos.se{{ image or '/media/morfos-splash-cocoon-poster.jpg' }}">
<link rel="preload" href="/fonts/outfit-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/site.css">
</head>
<body>
<a class="skip" href="#innehall">Hoppa till innehållet</a>
<header class="site-head">
  <div class="wrap">
    <a class="logo" href="/" aria-label="Morfos Edtech Akademi – startsida">
      <picture>
        <source srcset="/morfos-logo.webp" type="image/webp">
        <img src="/morfos-logo.png" width="654" height="539" alt="Morfos Edtech Akademi">
      </picture>
    </a>
    <nav class="site-nav" aria-label="Huvudmeny">
      <a href="/#sa-fungerar-det">Så fungerar det</a>
      <a href="/#provkurser">Provkurser</a>
      <a href="/om-oss/"{% if page.url == "/om-oss/" %} aria-current="page"{% endif %}>Om oss</a>
      <a href="/blogg/"{% if page.url.startsWith("/blogg/") %} aria-current="page"{% endif %}>Blogg</a>
      <a class="btn-gold" href="https://akademi.morfos.se">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><path d="M10 17l5-5-5-5"/><path d="M15 12H3"/></svg>
        Logga in i Akademin
      </a>
    </nav>
  </div>
</header>
<main id="innehall">
{{ content | safe }}
</main>
<footer class="site-foot">
  <div class="wrap">
    <div class="col">
      <a class="logo" href="/" aria-label="Morfos Edtech Akademi – startsida"><img src="/morfos-logo.png" width="654" height="539" alt="Morfos Edtech Akademi"></a>
      <p class="tagline">Kunskap som får form</p>
    </div>
    <div class="col">
      <p class="head">Kontakt</p>
      <a href="mailto:info@morfos.se">info@morfos.se</a>
      <span>Skövde</span>
    </div>
    <div class="col">
      <p class="head">Morfos</p>
      <a href="/om-oss/">Om oss</a>
      <a href="/blogg/">Blogg</a>
      <a href="https://akademi.morfos.se">Logga in i Akademin</a>
    </div>
    <p class="copy">© {{ year }} Morfos Edtech Akademi</p>
  </div>
</footer>
</body>
</html>
