<!DOCTYPE html>
<html lang="sv">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} – {% endif %}Morfos Edtech Akademi</title>
<meta name="description" content="{{ description or 'Blogg från Morfos Edtech Akademi om e-lärande, kursdesign och kompetensutveckling.' }}">
<link rel="canonical" href="https://www.morfos.se{{ page.url }}">
<link rel="alternate" type="application/atom+xml" title="Morfos blogg" href="/blogg/feed.xml">
<link rel="icon" type="image/png" sizes="32x32" href="/icon-32.png">
<link rel="apple-touch-icon" href="/icon-180.png">
<meta name="theme-color" content="#f8f7f2">
<meta property="og:site_name" content="Morfos Edtech Akademi">
<meta property="og:title" content="{{ title or 'Blogg' }}">
<meta property="og:url" content="https://www.morfos.se{{ page.url }}">
{% if image %}<meta property="og:image" content="https://www.morfos.se{{ image }}">{% endif %}
<style>
  @font-face { font-family: "Outfit"; font-weight: 400; font-display: swap; src: url(/fonts/outfit-latin-400-normal.woff2) format("woff2"); }
  @font-face { font-family: "Outfit"; font-weight: 500; font-display: swap; src: url(/fonts/outfit-latin-500-normal.woff2) format("woff2"); }
  :root { --bg: #f8f7f2; --ink: #122d23; --green: #205245; --sage: #6a8d77; --mist: #bbc1af; }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; background: var(--bg); color: var(--ink);
    font-family: "Outfit", system-ui, -apple-system, "Segoe UI", sans-serif;
    font-size: 1.0625rem; line-height: 1.65;
    min-height: 100vh; display: flex; flex-direction: column;
  }
  a { color: var(--green); text-decoration-color: var(--mist); text-underline-offset: 3px; }
  a:hover, a:focus-visible { text-decoration-color: var(--green); }
  .site-head {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    max-width: 46rem; width: 100%; margin: 0 auto; padding: 1.25rem 1.25rem 0;
  }
  .site-head img { height: 52px; width: auto; display: block; }
  .site-head nav a { text-decoration: none; font-weight: 500; margin-left: 1.25rem; }
  .site-head nav a[aria-current="page"] { border-bottom: 1.5px solid var(--green); }
  main { max-width: 46rem; width: 100%; margin: 0 auto; padding: 2.5rem 1.25rem 3rem; flex: 1; }
  h1, h2, h3 { font-weight: 500; line-height: 1.25; letter-spacing: .005em; }
  h1 { font-size: clamp(1.75rem, 5vw, 2.25rem); margin: 0 0 .5rem; }
  h2 { font-size: 1.4rem; margin: 2.25rem 0 .5rem; }
  h3 { font-size: 1.15rem; margin: 1.75rem 0 .4rem; }
  .lede { color: var(--sage); margin: 0 0 2rem; font-size: 1.1rem; }
  .rule { width: 56px; height: 2px; background: var(--mist); border: 0; margin: 1.5rem 0 2rem; }
  .meta { color: var(--sage); font-size: .92rem; margin: 0 0 1.75rem; }
  .post-list { list-style: none; padding: 0; margin: 0; }
  .post-list li { padding: 1.4rem 0; border-top: 1px solid var(--mist); }
  .post-list li:last-child { border-bottom: 1px solid var(--mist); }
  .post-list h2 { margin: .15rem 0 .35rem; font-size: 1.3rem; }
  .post-list h2 a { text-decoration: none; color: var(--ink); }
  .post-list h2 a:hover { color: var(--green); }
  .post-list p { margin: 0; }
  .post-list time { color: var(--sage); font-size: .9rem; }
  .empty { padding: 2rem 0; color: var(--sage); }
  article img { max-width: 100%; height: auto; border-radius: 6px; }
  article blockquote { margin: 1.5rem 0; padding: .25rem 0 .25rem 1.25rem; border-left: 3px solid var(--mist); color: var(--green); }
  article code { background: #ecebe3; padding: .1em .35em; border-radius: 4px; font-size: .92em; }
  .back { display: inline-block; margin-top: 2.5rem; }
  footer { text-align: center; font-size: .8rem; color: var(--sage); padding: 1.5rem 1.25rem; }
</style>
</head>
<body>
<header class="site-head">
  <a href="/" aria-label="Morfos Edtech Akademi – startsida">
    <picture>
      <source srcset="/morfos-logo.webp" type="image/webp">
      <img src="/morfos-logo.png" width="654" height="539" alt="Morfos Edtech Akademi">
    </picture>
  </a>
  <nav>
    <a href="/">Start</a>
    <a href="/blogg/"{% if page.url.startsWith("/blogg/") %} aria-current="page"{% endif %}>Blogg</a>
  </nav>
</header>
<main>
{{ content | safe }}
</main>
<footer>© {{ year }} Morfos Edtech Akademi · <a href="mailto:info@morfos.se">info@morfos.se</a></footer>
</body>
</html>
