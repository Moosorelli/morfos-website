layout: base.njk
---
<article>
  {% include "butterfly.svg" %}
  <h1>{{ title }}</h1>
  <p class="meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | svDate }}</time>{% if author %} · {{ author }}{% endif %}</p>
  {{ content | safe }}
  <div class="post-end">{% include "caterpillar.svg" %}</div>
</article>
